# Environment Variables for AI Voice Agent

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/ai-voice-agent

# OpenAI API Key (for GPT-3.5-turbo and Whisper)
OPENAI_API_KEY=your_openai_api_key_here

# OpenWeatherMap API Key (for weather data)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ElevenLabs API Key (for text-to-speech - optional, using Web Speech API instead)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Server Port (optional, defaults to 5000)
PORT=5000